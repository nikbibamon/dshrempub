    "menus": {
      "commandPalette": [
        {
          "command": "tvijo.choosePack",
          "when": "tvijo.hasPacks"
        }
      ],
      "editor/context": [
        {
          "command": "tvijo.ask",
          "when": "editorHasSelection",
          "group": "navigation@90"
        },
        {
          "command": "tvijo.attachSelection",
          "when": "editorHasSelection",
          "group": "navigation@91"
        }
      ],
      "explorer/context": [
        {
          "command": "tvijo.workInFolder",
          "when": "explorerResourceIsFolder",
          "group": "navigation@89"
        },
        {
          "command": "tvijo.attachFile",
          "when": "!explorerResourceIsFolder",
          "group": "7_modification@89"
        },
        {
          "command": "tvijo.addFileToKnowledge",
          "when": "!explorerResourceIsFolder",
          "group": "7_modification@90"
        }
      ],
      "view/title": [
        {
          "command": "tvijo.newConversation",
          "when": "view == tvijo.chat",
          "group": "navigation@1"
        },
        {
          "command": "tvijo.chooseThread",
          "when": "view == tvijo.chat",
          "group": "navigation@2"
        },
        {
          "command": "tvijo.openChatSettings",
          "when": "view == tvijo.chat",
          "group": "navigation@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "tvijo.ask",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t"
      },
      {
        "command": "tvijo.openChat",
        "key": "ctrl+alt+shift+t",
        "mac": "cmd+alt+shift+t"
      }
    ],
    "configuration": {
      "title": "Tvijo DSHREM",
      "properties": {
        "tvijo.pack": {
          "type": "string",
          "default": "",
          "markdownDescription": "%tvijo.pack.description%"
        },
        "tvijo.service": {
          "type": "string",
          "default": "standard",
          "markdownDescription": "%tvijo.service.description%"
        },
        "tvijo.model": {
          "type": "string",
          "default": "ds41f",
          "enum": [
            "coding",
            "auto",
            "ds41f",
            "glm53f",
            "devstral",
            "haiku55",
            "gpt61sol",
            "luna"
          ],
          "markdownDescription": "%tvijo.model.description%",
          "enumDescriptions": [
            "%tvijo.model.enum.0%",
            "%tvijo.model.enum.1%",
            "%tvijo.model.enum.2%",
            "%tvijo.model.enum.3%",
            "%tvijo.model.enum.4%",
            "%tvijo.model.enum.5%",
            "%tvijo.model.enum.6%",
            "%tvijo.model.enum.7%"
          ]
        },
        "tvijo.agentMode": {
          "type": "string",
          "default": "single",
          "enum": [
            "single",
            "auto",
            "council"
          ],
          "markdownDescription": "%tvijo.agentMode.description%",
          "enumDescriptions": [
            "%tvijo.agentMode.enum.0%",
            "%tvijo.agentMode.enum.1%",
            "%tvijo.agentMode.enum.2%"
          ]
        },
        "tvijo.reasoningMethod": {
          "type": "string",
          "default": "evidence-first",
          "enum": [
            "evidence-first",
            "plan-check",
            "peer-review"
          ],
          "markdownDescription": "%tvijo.reasoningMethod.description%",
          "enumDescriptions": [
            "%tvijo.reasoningMethod.enum.0%",
            "%tvijo.reasoningMethod.enum.1%",
            "%tvijo.reasoningMethod.enum.2%"
          ]
        },
        "tvijo.workspaceContext": {
          "type": "string",
          "default": "ask",
          "enum": [
            "ask",
            "on",
            "off"
          ],
          "markdownDescription": "%tvijo.workspaceContext.description%",
          "enumDescriptions": [
            "%tvijo.workspaceContext.enum.0%",
            "%tvijo.workspaceContext.enum.1%",
            "%tvijo.workspaceContext.enum.2%"
          ]
        },
        "tvijo.workspaceContextMaxBytes": {
          "type": "number",
          "default": 200000,
          "minimum": 4096,
          "maximum": 1000000,
          "markdownDescription": "%tvijo.workspaceContextMaxBytes.description%"
        },
        "tvijo.autoApply": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%tvijo.autoApply.description%"
        },
        "tvijo.agentModel": {
          "type": "string",
          "default": "ds41f",
          "enum": [
            "ds41f",
            "glm53f",
            "devstral",
            "coding",
            "auto",
            "haiku55",
            "gpt61sol",
            "luna"
          ],
          "markdownDescription": "%tvijo.agentModel.description%",
          "enumDescriptions": [
            "%tvijo.agentModel.enum.0%",
            "%tvijo.agentModel.enum.1%",
            "%tvijo.agentModel.enum.2%",
            "%tvijo.agentModel.enum.3%",
            "%tvijo.agentModel.enum.4%",
            "%tvijo.agentModel.enum.5%",
            "%tvijo.agentModel.enum.6%",
            "%tvijo.agentModel.enum.7%"
          ]
        },
        "tvijo.agentMaxSteps": {
          "type": "number",
          "default": 60,
          "minimum": 1,
          "maximum": 200,
          "markdownDescription": "%tvijo.agentMaxSteps.description%"
        },
        "tvijo.agentBudgetUsd": {
          "type": "number",
          "default": 2,
          "minimum": 0.01,
          "maximum": 100,
          "markdownDescription": "%tvijo.agentBudgetUsd.description%"
        },
        "tvijo.agentAutoRun": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%tvijo.agentAutoRun.description%"
        },
        "tvijo.agentAutoApply": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%tvijo.agentAutoApply.description%"
        },
        "tvijo.bridge.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "markdownDescription": "%tvijo.bridge.enabled.description%"
        },
        "tvijo.telegram.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "markdownDescription": "%tvijo.telegram.enabled.description%"
        },
        "tvijo.telegram.ownerId": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "%tvijo.telegram.ownerId.description%",
          "markdownDeprecationMessage": "%tvijo.telegram.ownerId.deprecated%"
        },
        "tvijo.ocrLanguages": {
          "type": "string",
          "default": "eng+rus",
          "scope": "machine",
          "markdownDescription": "%tvijo.ocrLanguages.description%"
        },
        "tvijo.apiBase": {
          "type": "string",
          "default": "https://dsh.tvijo.com/api/dshrem/v1",
          "markdownDescription": "%tvijo.apiBase.description%"
        },
        "tvijo.telegram.allowedServices": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine",
          "markdownDescription": "%tvijo.telegram.allowedServices.description%"
        },
        "tvijo.autoCommit": {
          "type": "string",
          "default": "afterTask",
          "enum": [
            "afterTask",
            "off"
          ],
          "markdownDescription": "%tvijo.autoCommit.description%",
          "enumDescriptions": [
            "%tvijo.autoCommit.enum.0%",
            "%tvijo.autoCommit.enum.1%"
          ]
        },
        "tvijo.orchestration.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%tvijo.orchestration.enabled.description%",
          "scope": "machine"
        },
        "tvijo.orchestration.profile": {
          "type": "string",
          "default": "dsh-harness",
          "enum": [
            "dsh-harness"
          ],
          "markdownDescription": "%tvijo.orchestration.profile.description%",
          "scope": "machine",
          "enumDescriptions": [
            "%tvijo.orchestration.profile.enum.0%"
          ]
        },
        "tvijo.orchestration.workerPolicy": {
          "type": "string",
          "default": "sol",
          "enum": [
            "sol",
            "sol-astra",
            "sol-astra-claude",
            "sol-claude"
          ],
          "markdownDescription": "%tvijo.orchestration.workerPolicy.description%",
          "scope": "machine",
          "enumDescriptions": [
            "%tvijo.orchestration.workerPolicy.enum.0%",
            "%tvijo.orchestration.workerPolicy.enum.1%",
            "%tvijo.orchestration.workerPolicy.enum.2%",
            "%tvijo.orchestration.workerPolicy.enum.3%"
          ]
        },
        "tvijo.orchestration.controllerPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%tvijo.orchestration.controllerPath.description%",
          "scope": "machine"
        },
        "tvijo.orchestration.pythonPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%tvijo.orchestration.pythonPath.description%",
          "scope": "machine"
        },
        "tvijo.orchestration.statePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%tvijo.orchestration.statePath.description%",
          "scope": "machine"
        },
        "tvijo.colorTheme": {
          "type": "string",
          "default": "blue",
          "enum": [
            "blue",
            "violet",
            "teal",
            "amber",
            "mono",
            "spectrum"
          ],
          "markdownDescription": "%tvijo.colorTheme.description%",
          "enumDescriptions": [
            "%tvijo.colorTheme.enum.0%",
            "%tvijo.colorTheme.enum.1%",
            "%tvijo.colorTheme.enum.2%",
            "%tvijo.colorTheme.enum.3%",
            "%tvijo.colorTheme.enum.4%",
            "%tvijo.colorTheme.enum.5%"
          ]
        },
        "tvijo.commitIdentity": {
          "type": "string",
          "default": "git",
          "enum": [
            "git",
            "private",
            "tvijo"
          ],
          "markdownDescription": "%tvijo.commitIdentity.description%",
          "enumDescriptions": [
            "%tvijo.commitIdentity.enum.0%",
            "%tvijo.commitIdentity.enum.1%",
            "%tvijo.commitIdentity.enum.2%"
          ]
        },
        "tvijo.orchestration.agentCount": {
          "type": "number",
          "default": 3,
          "minimum": 3,
          "maximum": 6,
          "scope": "machine",
          "markdownDescription": "%tvijo.orchestration.agentCount.description%"
        },
        "tvijo.orchestration.reportFormat": {
          "type": "string",
          "default": "both",
          "enum": [
            "light",
            "dark",
            "rainbow",
            "both"
          ],
          "scope": "machine",
          "markdownDescription": "%tvijo.orchestration.reportFormat.description%",
          "enumDescriptions": [
            "%tvijo.orchestration.reportFormat.enum.0%",
            "%tvijo.orchestration.reportFormat.enum.1%",
            "%tvijo.orchestration.reportFormat.enum.2%",
            "%tvijo.orchestration.reportFormat.enum.3%"
          ]
        },
        "tvijo.agentReview.claudeEnabled": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "markdownDescription": "%tvijo.agentReview.claudeEnabled.description%"
        }
      }
    },
    "languageModelTools": [
      {
        "name": "tvijo_ask",
        "displayName": "Ask Tvijo",
        "toolReferenceName": "tvijo",
        "canBeReferencedInPrompt": true,
        "icon": "media/tvijo.svg",
        "userDescription": "Send a task to the Tvijo agent and return its answer.",
        "modelDescription": "Sends a task to the Tvijo coding agent in this VS Code window and waits for its answer. Tvijo runs it as a normal paid task with the user's current Tvijo preset and project rules. Use it when the user asks to involve Tvijo, or to get a second agent's work on this project. Returns Tvijo's final answer text, or its failure state.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "task": {
              "type": "string",
              "description": "The task for Tvijo, written as a complete instruction."
            },
            "mode": {
              "type": "string",
              "enum": [
                "agent",
                "plan",
                "chat"
              ],
              "description": "agent edits and runs commands per the user's preset; plan only inspects; chat answers without tools. Default agent."
            }
          },
          "required": [
            "task"
          ]
        }
      }
    ],
    "chatParticipants": [
      {
        "id": "tvijo.agent",
        "name": "tvijo",
        "fullName": "Tvijo",
        "description": "Send a task to the Tvijo agent",
        "isSticky": false
      }
    ]
  },
  "scripts": {
    "test": "node ../scripts/test-runner.mjs --extension",
    "compile": "node scripts/compile.cjs"
  }
}
