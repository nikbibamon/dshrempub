    "menus": {
      "editor/context": [
        {
          "command": "tvijo.ask",
          "when": "editorHasSelection",
          "group": "navigation@90"
        },
        {
          "command": "tvijo.attachSelection",
          "when": "editorHasSelection",
          "group": "navigation@91"
        }
      ],
      "explorer/context": [
        {
          "command": "tvijo.attachFile",
          "when": "!explorerResourceIsFolder",
          "group": "7_modification@89"
        },
        {
          "command": "tvijo.addFileToKnowledge",
          "when": "!explorerResourceIsFolder",
          "group": "7_modification@90"
        }
      ]
    },
    "keybindings": [
      {
        "command": "tvijo.ask",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t"
      },
      {
        "command": "tvijo.openChat",
        "key": "ctrl+alt+shift+t",
        "mac": "cmd+alt+shift+t"
      }
    ],
    "configuration": {
      "title": "Tvijo DSHREM",
      "properties": {
        "tvijo.service": {
          "type": "string",
          "default": "standard",
          "description": "Tvijo service for shared projects. Its immutable quote is reserved before each task."
        },
        "tvijo.model": {
          "type": "string",
          "default": "coding",
          "enum": [
            "coding",
            "auto",
            "ds41f",
            "glm53f",
            "devstral",
            "haiku55",
            "gpt61sol",
            "luna"
          ],
          "description": "Requested model alias. The server refuses unavailable routes; no silent paid fallback."
        },
        "tvijo.agentMode": {
          "type": "string",
          "default": "single",
          "enum": [
            "single",
            "auto",
            "council"
          ],
          "description": "Single model, deterministic routing, or DeepSeek + GLM council under one shared $1 task cap."
        },
        "tvijo.reasoningMethod": {
          "type": "string",
          "default": "evidence-first",
          "enum": [
            "evidence-first",
            "plan-check",
            "peer-review"
          ],
          "description": "Reasoning workflow. Method selection is not a guarantee of higher quality or lower cost."
        },
        "tvijo.workspaceContext": {
          "type": "string",
          "default": "ask",
          "enum": [
            "ask",
            "on",
            "off"
          ],
          "description": "Send a bounded project tree, README, manifests and the active file with each question. Secrets and binaries are excluded locally. 'ask' asks once, then remembers the choice."
        },
        "tvijo.workspaceContextMaxBytes": {
          "type": "number",
          "default": 48000,
          "minimum": 4096,
          "maximum": 200000,
          "description": "Hard byte limit for the generated project-context block."
        },
        "tvijo.autoApply": {
          "type": "boolean",
          "default": false,
          "description": "Apply a reviewed quick-edit diff without the confirmation dialog. The file is still not saved automatically."
        },
        "tvijo.agentModel": {
          "type": "string",
          "default": "ds41f",
          "enum": [
            "ds41f",
            "glm53f",
            "devstral",
            "coding",
            "auto",
            "haiku55",
            "gpt61sol",
            "luna"
          ],
          "description": "Model used for each agent step. A cheap JSON-reliable route is recommended; the server refuses an unavailable route."
        },
        "tvijo.agentMaxSteps": {
          "type": "number",
          "default": 6,
          "minimum": 1,
          "maximum": 12,
          "description": "Maximum model turns in one agent task. Each turn is a separate paid task with the service per-task cap."
        },
        "tvijo.agentBudgetUsd": {
          "type": "number",
          "default": 2,
          "minimum": 0.01,
          "maximum": 10,
          "description": "Local session budget for the agent loop. It refuses to start another model turn above this amount. It does not replace the service cap."
        },
        "tvijo.agentAutoRun": {
          "type": "boolean",
          "default": false,
          "description": "Run build/test/lint commands without a per-command confirmation when they match the local allowlist. Destructive commands stay blocked."
        },
        "tvijo.agentAutoApply": {
          "type": "boolean",
          "default": false,
          "description": "Write agent file edits without the per-file confirmation. A diff is still opened and the editor buffer is not saved automatically."
        },
        "tvijo.telegram.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "Start your owner-only Telegram connector on this extension host. Requires Configure Telegram bot first."
        },
        "tvijo.telegram.ownerId": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Numeric Telegram ID allowed to control your bot in private chat. BotFather token is stored separately in SecretStorage."
        },
        "tvijo.ocrLanguages": {
          "type": "string",
          "default": "eng+rus",
          "scope": "machine",
          "description": "Installed Tesseract languages used for local PNG/JPG text extraction. For example eng or eng+rus. Images are not sent to a vision model."
        },
        "tvijo.apiBase": {
          "type": "string",
          "default": "https://dsh.tvijo.com/api/dshrem/v1",
          "description": "Service URL. HTTPS is required; plain HTTP is accepted only for localhost development."
        },
        "tvijo.telegram.allowedServices": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine",
          "description": "Exact systemd .service names this owner may inspect/restart. Restarts need a fresh 60-second Telegram confirmation. Empty disables service control."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  }
}
