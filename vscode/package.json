{
  "name": "tvijo-dshrem",
  "displayName": "Tvijo DSHREM",
  "description": "Managed coding and bounded reviews for shared projects with a per-task spending cap. Provider API credentials remain on the service.",
  "version": "0.10.25",
  "repository": {
    "type": "git",
    "url": "https://github.com/nikbibamon/dshrempub.git",
    "directory": "vscode"
  },
  "homepage": "https://dsh.tvijo.com",
